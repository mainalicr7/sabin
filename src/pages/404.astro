---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page does not exist on Sabin Mainali's portfolio." noindex>
  <section class="wrap flex min-h-[64dvh] flex-col justify-center py-24" aria-labelledby="nf-title">
    <p class="font-display text-[clamp(5rem,3rem+10vw,11rem)] leading-none text-line-strong" aria-hidden="true" style="font-variation-settings:'SOFT' 100,'WONK' 1">404</p>
    <h1 id="nf-title" class="mt-4 text-[clamp(2rem,1.4rem+2.4vw,3.2rem)]">This page is not in the system</h1>
    <p class="mt-4 max-w-[52ch] text-lg text-muted">
      I would have caught this in verification, but the link you followed may be old or mistyped. These pages definitely exist:
    </p>
    <ul class="mt-8 flex flex-wrap gap-3">
      <li><a href="/" class="btn btn-primary">Home</a></li>
      <li><a href="/work/" class="btn btn-ghost">Work</a></li>
      <li><a href="/services/" class="btn btn-ghost">Services</a></li>
      <li><a href="/contact/" class="btn btn-ghost">Contact</a></li>
    </ul>
  </section>
</Base>
