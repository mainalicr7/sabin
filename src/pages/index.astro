---
import { getCollection } from 'astro:content';
import Check from '@lucide/astro/icons/check';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Base from '../layouts/Base.astro';
import SystemMap from '../components/SystemMap.astro';
import CaseRow from '../components/CaseRow.astro';
import Faq from '../components/Faq.astro';
import DisciplineIcon from '../components/DisciplineIcon.astro';
import ToolLogos from '../components/ToolLogos.astro';
import BuiltSection from '../components/BuiltSection.astro';
import MiniVisual from '../components/MiniVisual.astro';
import { profile, disciplines, method, faqs, links, projects, type DisciplineId } from '../data/site';
import { faqNode, absolute } from '../lib/seo';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const featured = work.filter((w) => w.data.featured).slice(0, 4);
const productWork = work.filter((w) => w.data.disciplines.includes('product') && w.id !== 'chatonics').slice(0, 2);
const headline = 'Product, design, data and AI as one system.'.split(' ');
const d = Object.fromEntries(disciplines.map((x) => [x.id, x])) as Record<DisciplineId, (typeof disciplines)[number]>;

const facts = [
  { label: 'Current role', value: `${profile.jobTitle}, ${profile.employer.name}` },
  { label: 'Built', value: 'Chatonics' },
  { label: 'Working since', value: String(profile.experienceSince) },
  { label: 'Time zone', value: 'UTC+5:45, Kathmandu' },
];

const schema = [
  {
    '@type': 'ProfilePage',
    '@id': absolute(Astro.site, '/#webpage'),
    url: absolute(Astro.site, '/'),
    name: `${profile.name} - AI-native product manager`,
    mainEntity: { '@id': absolute(Astro.site, '/#person') },
    isPartOf: { '@id': absolute(Astro.site, '/#website') },
  },
  {
    '@type': 'SoftwareApplication',
    name: projects[0].name,
    url: projects[0].url,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    description: projects[0].summary,
    creator: { '@id': absolute(Astro.site, '/#person') },
  },
  faqNode(faqs),
];
---

<Base
  title={`${profile.name} - AI-native product manager`}
  description="Sabin Mainali is a product manager in Kathmandu who builds the whole product system: roadmap, design systems, help centers, data analysis and AI automation."
  type="profile"
  schema={schema}
>
  <!-- Hero: message left, live system diagram right -->
  <section class="wrap grid items-center gap-12 pt-12 pb-20 md:pt-16 lg:grid-cols-12 lg:gap-8 lg:pt-20 lg:pb-24" aria-labelledby="hero-heading">
    <div class="lg:col-span-7">
      {
        profile.availability.open && (
          <p class="rise inline-flex items-center gap-2 rounded-full border border-line bg-surface py-1.5 pr-3.5 pl-2.5 text-[0.8125rem] text-muted">
            <span class="relative flex size-2" aria-hidden="true">
              <span class="absolute inline-flex size-full rounded-full bg-emerald-500 opacity-50 motion-safe:animate-ping" />
              <span class="relative inline-flex size-2 rounded-full bg-emerald-500" />
            </span>
            Sabin Mainali, available for freelance projects
          </p>
        )
      }
      <h1 id="hero-heading" class="mt-7 text-[clamp(2.6rem,1.7rem+3.2vw,4rem)] leading-[1.02] font-extrabold tracking-[-0.03em]">
        <span class="sr-only">Sabin Mainali, AI-native product manager. </span>
        {headline.map((word, i) => (
          <>
            <span class="word-mask"><span class="word" style={`--i:${i}`}>{word}</span></span>{i < headline.length - 1 && ' '}
          </>
        ))}
      </h1>
      <p class="rise mt-6 max-w-[44ch] text-lg leading-relaxed text-muted [animation-delay:420ms]">
        I lead product at Calilio, built Chatonics, and take freelance projects from strategy to shipped automation.
      </p>
      <div class="rise mt-9 flex flex-wrap items-center gap-3 [animation-delay:520ms]">
        <a href="/contact/" class="btn btn-primary">Hire me</a>
        <a href="/work/" class="btn btn-ghost">View work</a>
      </div>
    </div>
    <div class="rise [animation-delay:600ms] lg:col-span-5 lg:col-start-8">
      <SystemMap />
    </div>
  </section>

  <!-- Key facts -->
  <section aria-label="Key facts" class="border-y border-line bg-surface">
    <dl class="wrap grid grid-cols-2 lg:grid-cols-4">
      {
        facts.map((f, i) => (
          <div class:list={['py-6 lg:py-7', i % 2 === 1 && 'pl-5 border-l border-line', i >= 2 && 'border-t border-line lg:border-t-0', i === 2 && 'lg:pl-5 lg:border-l']}>
            <dt class="text-[0.8125rem] text-muted">{f.label}</dt>
            <dd class="mt-1 font-display text-lg font-bold tracking-[-0.01em] sm:text-xl">{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <BuiltSection />

  <!-- What I do: bento -->
  <section id="what-i-do" class="wrap mt-28" aria-labelledby="do-heading">
    <h2 id="do-heading" class="text-[clamp(2rem,1.4rem+2.2vw,3rem)]" data-reveal>What I do</h2>
    <p class="mt-4 max-w-[58ch] text-lg text-muted">
      Seven disciplines that usually sit with seven people. I run them together, so each one feeds the next.
    </p>

    <ul class="mt-12 grid auto-rows-auto gap-4 md:grid-cols-6 lg:grid-cols-12">
      <!-- Product: anchor tile -->
      <li data-reveal class="spotlight relative flex flex-col overflow-hidden rounded-2xl border border-line bg-accent-soft p-7 md:col-span-6 lg:col-span-7 lg:row-span-2 lg:p-9">
        <div class="dot-grid pointer-events-none absolute inset-x-0 top-0 h-48 [mask-image:linear-gradient(to_bottom,black,transparent)]" aria-hidden="true"></div>
        <span class="relative grid size-11 place-items-center rounded-xl bg-accent text-on-accent"><DisciplineIcon id="product" /></span>
        <h3 class="relative mt-8 text-[clamp(1.6rem,1.3rem+1vw,2.1rem)]">{d.product.name}</h3>
        <p class="relative mt-3 max-w-[44ch] text-muted">{d.product.summary}</p>
        <ul class="relative mt-8 grid gap-3 sm:grid-cols-2">
          {
            d.product.points.map((p) => (
              <li class="flex gap-2.5 text-[0.9375rem]">
                <Check class="mt-1 size-4 shrink-0 text-accent" stroke-width={2} aria-hidden="true" />
                <span>{p}</span>
              </li>
            ))
          }
        </ul>
        <div class="relative mt-auto pt-10">
          <p class="text-[0.8125rem] text-muted">Product case studies</p>
          <ul class="mt-3 divide-y divide-line overflow-hidden rounded-xl border border-line bg-surface">
            {
              productWork.map((w) => (
                <li>
                  <a href={`/work/${w.id}/`} class="group flex items-center justify-between gap-4 px-4 py-3.5 text-[0.9375rem] transition-colors hover:bg-accent-soft">
                    <span>{w.data.title}</span>
                    <ArrowUpRight class="size-4 shrink-0 text-muted transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent" stroke-width={1.5} aria-hidden="true" />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </li>

      <!-- Design -->
      <li data-reveal style="--i:1" class="group spotlight lift flex flex-col rounded-2xl border border-line bg-surface p-7 md:col-span-3 lg:col-span-5">
        <div class="flex items-start justify-between gap-4">
          <span class="grid size-11 place-items-center rounded-xl border border-line text-ink"><DisciplineIcon id="design" /></span>
          <MiniVisual kind="swatches" />
        </div>
        <h3 class="mt-6 text-xl">{d.design.name}</h3>
        <p class="mt-2 text-[0.9375rem] text-muted">{d.design.summary}</p>
        <ul class="mt-auto flex flex-wrap gap-1.5 pt-6" aria-label="Examples">
          {d.design.tags.map((t) => <li class="rounded-full border border-line px-2.5 py-1 text-[0.8125rem] text-muted">{t}</li>)}
        </ul>
      </li>

      <!-- AI: inverted tile -->
      <li data-reveal style="--i:2" class="lift relative flex flex-col overflow-hidden rounded-2xl bg-tile p-7 text-tile-text md:col-span-3 lg:col-span-5">
        <div class="ai-glow pointer-events-none absolute -top-24 -right-24 size-64 rounded-full" aria-hidden="true"></div>
        <span class="relative grid size-11 place-items-center rounded-xl border border-tile-line text-tile-text"><DisciplineIcon id="ai" /></span>
        <h3 class="relative mt-6 text-xl">{d.ai.name}</h3>
        <p class="relative mt-2 text-[0.9375rem] text-tile-muted">{d.ai.summary}</p>
        <div class="relative mt-auto flex flex-wrap items-center justify-between gap-3 pt-6">
          <ul class="flex flex-wrap gap-1.5" aria-label="Examples">
            {d.ai.tags.map((t) => <li class="rounded-full border border-tile-line px-2.5 py-1 text-[0.8125rem] text-tile-muted">{t}</li>)}
          </ul>
          <a href="/ai-lab/" class="text-sm text-tile-text underline decoration-tile-line underline-offset-4 hover:decoration-current">See the AI Lab</a>
        </div>
      </li>

      <!-- Content, Data, Sales -->
      {
        (['content', 'data', 'sales'] as const).map((id, i) => (
          <li data-reveal style={`--i:${i}`} class="spotlight lift flex flex-col rounded-2xl border border-line bg-surface p-7 md:col-span-2 lg:col-span-4">
            <span class="grid size-11 place-items-center rounded-xl border border-line text-ink">
              <DisciplineIcon id={id} />
            </span>
            <div class="mt-6 flex h-[4.25rem] items-center">
              <MiniVisual kind={id === 'data' ? 'spark' : id === 'sales' ? 'funnel' : 'checks'} class="w-full" />
            </div>
            <h3 class="mt-6 text-xl">{d[id].name}</h3>
            <p class="mt-2 text-[0.9375rem] text-muted">{d[id].summary}</p>
            <ul class="mt-auto flex flex-wrap gap-1.5 pt-6" aria-label="Examples">
              {d[id].tags.map((t) => (
                <li class="rounded-full border border-line px-2.5 py-1 text-[0.8125rem] text-muted">{t}</li>
              ))}
            </ul>
          </li>
        ))
      }

      <!-- Motion: wide strip with a timeline texture -->
      <li data-reveal class="spotlight relative grid overflow-hidden rounded-2xl border border-line bg-surface md:col-span-6 lg:col-span-12 lg:grid-cols-12">
        <div class="flex flex-col p-7 lg:col-span-6 lg:p-9">
          <span class="grid size-11 place-items-center rounded-xl border border-line text-ink"><DisciplineIcon id="motion" /></span>
          <h3 class="mt-6 text-xl">{d.motion.name}</h3>
          <p class="mt-2 max-w-[48ch] text-[0.9375rem] text-muted">{d.motion.summary}</p>
          <ul class="mt-6 flex flex-wrap gap-1.5" aria-label="Examples">
            {d.motion.tags.map((t) => <li class="rounded-full border border-line px-2.5 py-1 text-[0.8125rem] text-muted">{t}</li>)}
          </ul>
        </div>
        <div class="timeline relative hidden border-l border-line lg:col-span-6 lg:block" aria-hidden="true">
          <div class="absolute inset-x-8 top-1/2 flex -translate-y-1/2 flex-col gap-2.5">
            <span class="track w-[88%]"></span>
            <span class="track ml-[12%] w-[64%] bg-accent-soft"></span>
            <span class="track ml-[30%] w-[58%]"></span>
          </div>
          <span class="playhead"></span>
        </div>
      </li>
    </ul>
  </section>

  <!-- Selected work -->
  <section id="selected-work" class="wrap mt-28" aria-labelledby="work-heading">
    <h2 id="work-heading" class="text-[clamp(2rem,1.4rem+2.2vw,3rem)]" data-reveal>Selected work</h2>
    <p class="mt-4 max-w-[58ch] text-lg text-muted">
      Each case study covers the problem, what I built and what changed. Confidential numbers stay out.
    </p>
    <div class="mt-10 border-b border-line" data-preview-area>
      {featured.map((entry, i) => <CaseRow entry={entry} index={i} />)}
    </div>
    <div class="work-preview" aria-hidden="true" data-work-preview>
      <p class="text-[0.75rem] text-muted">Outcome</p>
      <p class="mt-1 text-[0.9375rem] leading-snug" data-work-preview-text></p>
    </div>
    <a href="/work/" class="btn btn-ghost mt-8">View work</a>
  </section>

  <!-- How I work -->
  <section id="how-i-work" class="wrap mt-28" aria-labelledby="method-heading">
    <h2 id="method-heading" class="text-[clamp(2rem,1.4rem+2.2vw,3rem)]" data-reveal>How I work</h2>
    <p class="mt-4 max-w-[58ch] text-lg text-muted">Every project runs through the same four steps, in this order.</p>
    <ol class="relative mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
      <span class="absolute top-[1.1rem] right-0 left-0 hidden h-px bg-line lg:block" aria-hidden="true"></span>
      <span class="method-fill absolute top-[1.1rem] right-0 left-0 hidden h-px bg-accent lg:block" aria-hidden="true"></span>
      {
        method.map((m, i) => (
          <li class="relative" data-reveal style={`--i:${i}`}>
            <span class="method-dot relative grid size-9 place-items-center rounded-full border border-line bg-bg font-mono text-[0.8125rem] text-accent" aria-hidden="true">
              {i + 1}
            </span>
            <h3 class="mt-5 text-lg">{m.name}</h3>
            <p class="mt-2 max-w-[32ch] text-[0.9375rem] text-muted">{m.detail}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Tools -->
  <section id="tools" class="wrap mt-28" aria-labelledby="tools-heading">
    <h2 id="tools-heading" class="text-[clamp(1.6rem,1.3rem+1.2vw,2.2rem)]" data-reveal>Tools I work with</h2>
    <div class="mt-8">
      <ToolLogos />
    </div>
  </section>

  <!-- About -->
  <section id="about" class="wrap mt-28" aria-labelledby="about-heading">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-7">
        <h2 id="about-heading" class="text-[clamp(2rem,1.4rem+2.2vw,3rem)]" data-reveal>About Sabin</h2>
        <p class="mt-6 max-w-[56ch] text-lg">
          I started in IT operations in {profile.experienceSince}, moved into business analysis, and now lead product and growth at Calilio.
        </p>
        <p class="mt-4 max-w-[56ch] text-muted">
          I do not hand work off at the spec. I write the design system, plan the help center, run the analysis, build the sales playbooks, make the videos, and build the AI tooling that lets one person work like a small product team.
        </p>
        <a href="/about/" class="btn btn-ghost mt-8">Read the full story</a>
      </div>
      <figure data-reveal style="--i:1" class="flex flex-col justify-between rounded-2xl border border-line bg-surface p-8 lg:col-span-5">
        <blockquote class="text-[clamp(1.35rem,1.15rem+0.8vw,1.75rem)] font-medium leading-snug tracking-[-0.02em]">
          <p>Most 'AI agents' I see are chatbots with extra steps. A chatbot answers. An agent finishes.</p>
        </blockquote>
        <figcaption class="mt-8 text-sm text-muted">
          Sabin Mainali, Product Manager, writing on <a class="link" href={links.linkedin} target="_blank" rel="noopener">LinkedIn<span class="sr-only"> (opens in a new tab)</span></a>
        </figcaption>
      </figure>
    </div>
  </section>

  <Faq items={faqs} />
</Base>

<script>
  // Selected work: a small outcome card follows the cursor over each case study row.
  const area = document.querySelector<HTMLElement>('[data-preview-area]');
  const card = document.querySelector<HTMLElement>('[data-work-preview]');
  const text = document.querySelector('[data-work-preview-text]');
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (area && card && text && fine) {
    let x = 0;
    let y = 0;
    let cx = 0;
    let cy = 0;
    let frame = 0;
    const follow = () => {
      cx += (x - cx) * (reduced ? 1 : 0.18);
      cy += (y - cy) * (reduced ? 1 : 0.18);
      card.style.transform = `translate3d(${cx + 18}px, ${cy + 18}px, 0)`;
      frame = Math.abs(x - cx) + Math.abs(y - cy) > 0.5 ? requestAnimationFrame(follow) : 0;
    };
    area.querySelectorAll<HTMLElement>('.case-row').forEach((row) => {
      row.addEventListener('pointerenter', (e) => {
        text.textContent = row.dataset.outcome || '';
        x = cx = e.clientX;
        y = cy = e.clientY;
        card.classList.add('is-visible');
        follow();
      });
      row.addEventListener('pointerleave', () => card.classList.remove('is-visible'));
    });
    area.addEventListener('pointermove', (e) => {
      x = e.clientX;
      y = e.clientY;
      if (!frame) frame = requestAnimationFrame(follow);
    });
  }
</script>

<style>
  .work-preview {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 40;
    width: 18rem;
    padding: 0.9rem 1rem;
    border-radius: 1rem;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    backdrop-filter: blur(10px);
    box-shadow: 0 24px 48px -24px rgb(0 0 0 / 0.4);
    pointer-events: none;
    opacity: 0;
    scale: 0.92;
    transition: opacity 220ms ease, scale 320ms var(--ease-out-soft);
  }
  .work-preview.is-visible {
    opacity: 1;
    scale: 1;
  }

  /* How I work: the rail fills and each step lights up as the section scrolls into view. */
  .method-fill {
    transform-origin: left;
    transform: scaleX(1);
  }
  @supports (animation-timeline: view()) {
    .method-fill {
      animation: rail linear both;
      animation-timeline: view();
      animation-range: entry 40% cover 55%;
    }
    .method-dot {
      animation: dot linear both;
      animation-timeline: view();
      animation-range: entry 60% cover 45%;
    }
  }
  @keyframes rail {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  @keyframes dot {
    from {
      border-color: var(--line);
      background: var(--bg);
      color: var(--accent);
    }
    to {
      border-color: var(--accent);
      background: var(--accent);
      color: var(--on-accent);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .method-fill,
    .method-dot {
      animation: none;
    }
  }

  .ai-glow {
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 45%, transparent), transparent 70%);
    opacity: 0.55;
  }
  .timeline {
    background-image: repeating-linear-gradient(to right, var(--line) 0 1px, transparent 1px 32px);
    background-size: 100% 12px;
    background-repeat: no-repeat;
    background-position: 0 1.5rem;
  }
  .track {
    display: block;
    height: 1.75rem;
    border-radius: 0.5rem;
    border: 1px solid var(--line);
    background: var(--surface-2);
  }
  .playhead {
    position: absolute;
    top: 1rem;
    bottom: 1rem;
    left: 12%;
    width: 74%;
    animation: playhead 9s ease-in-out infinite alternate;
  }
  .playhead::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 1.5px;
    background: var(--accent);
  }
  @keyframes playhead {
    to {
      transform: translateX(100%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .playhead {
      animation: none;
      transform: translateX(62%);
    }
  }
  .playhead::before {
    content: '';
    position: absolute;
    top: -2px;
    left: 0.75px;
    width: 9px;
    height: 9px;
    border-radius: 2px;
    background: var(--accent);
    transform: translateX(-50%) rotate(45deg);
  }
</style>
