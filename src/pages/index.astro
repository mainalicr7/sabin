---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SystemMap from '../components/SystemMap.astro';
import CaseRow from '../components/CaseRow.astro';
import ContactCta from '../components/ContactCta.astro';
import Faq from '../components/Faq.astro';
import { profile, disciplines, method, toolGroups, faqs, links } from '../data/site';
import { faqNode, absolute } from '../lib/seo';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const featured = work.filter((w) => w.data.featured).slice(0, 4);
const allIds = work.map((w) => w.id);

// Bento layout: wide cards for the two disciplines that anchor the rest.
const wide = new Set(['product', 'ai']);

const schema = [
  {
    '@type': 'ProfilePage',
    '@id': absolute(Astro.site, '/#webpage'),
    url: absolute(Astro.site, '/'),
    name: `${profile.name} - AI-native product manager`,
    mainEntity: { '@id': absolute(Astro.site, '/#person') },
    isPartOf: { '@id': absolute(Astro.site, '/#website') },
  },
  faqNode(faqs),
];
---

<Base
  title={`${profile.name} - AI-native product manager`}
  description="Sabin Mainali is a product manager in Kathmandu who builds the whole product system: roadmap, design systems, help centers, data analysis and AI automation."
  type="profile"
  schema={schema}
>
  <!-- Hero -->
  <section class="wrap grid items-center gap-14 pt-14 pb-10 md:pt-20 lg:grid-cols-12 lg:gap-8 lg:pt-24" aria-labelledby="hero-heading">
    <div class="lg:col-span-7">
      {
        profile.availability.open && (
          <p class="rise flex items-center gap-2 text-sm text-muted">
            <span class="inline-block size-2 rounded-full bg-accent" aria-hidden="true" />
            {profile.availability.label}
          </p>
        )
      }
      <h1 id="hero-heading" class="rise mt-6 [animation-delay:80ms]">
        <span class="block font-sans text-lg font-medium tracking-normal text-muted">Sabin Mainali, product manager</span>
        <span
          class="mt-4 block text-[clamp(2.6rem,1.4rem+5.2vw,5.4rem)] leading-[1.02] tracking-[-0.035em]"
          style="font-variation-settings:'SOFT' 20,'WONK' 1;"
        >
          I run product, design, data, content and AI as one system.
        </span>
      </h1>
      <p class="rise mt-7 max-w-[54ch] text-lg text-muted [animation-delay:160ms]">
        I lead product and growth at <a class="link text-ink" href={profile.employer.url} target="_blank" rel="noopener">Calilio<span class="sr-only"> (opens in a new tab)</span></a>, a cloud phone system for businesses. I plan the roadmap, and I also build the design system, the help center, the analysis and the AI tooling behind it.
      </p>
      <div class="rise mt-9 flex flex-wrap gap-3 [animation-delay:240ms]">
        <a href="/work/" class="btn btn-primary">View work</a>
        <a href="/contact/" class="btn btn-ghost">Get in touch</a>
      </div>
    </div>
    <div class="rise [animation-delay:320ms] lg:col-span-5">
      <SystemMap />
    </div>
  </section>

  <!-- What I do -->
  <section id="what-i-do" class="wrap mt-24" aria-labelledby="do-heading">
    <div class="grid gap-6 md:grid-cols-12">
      <h2 id="do-heading" class="text-[clamp(2.2rem,1.5rem+2.6vw,3.6rem)] md:col-span-5">What I do</h2>
      <p class="max-w-[52ch] text-lg text-muted md:col-span-6 md:col-start-7 md:pt-3">
        I cover seven disciplines that usually sit with seven different people. Each one feeds the others, which is why I build them as one system.
      </p>
    </div>

    <ul class="mt-12 grid gap-4 md:grid-cols-3">
      {
        disciplines.map((d) => (
          <li
            class:list={[
              'flex flex-col rounded-2xl border border-line bg-surface p-6 md:p-8',
              wide.has(d.id) && 'md:col-span-2',
            ]}
          >
            <h3 class="text-2xl">{d.name}</h3>
            <p class="mt-3 text-muted">{d.summary}</p>
            <ul class:list={['mt-6 space-y-2 border-t border-line pt-5 text-[0.95rem]', wide.has(d.id) && 'sm:columns-2 sm:gap-8']}>
              {d.points.map((p) => (
                <li class="break-inside-avoid pl-4 relative before:absolute before:left-0 before:top-[0.7em] before:h-px before:w-2 before:bg-accent">{p}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Selected work -->
  <section id="selected-work" class="wrap mt-28" aria-labelledby="work-heading">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div>
        <h2 id="work-heading" class="text-[clamp(2.2rem,1.5rem+2.6vw,3.6rem)]">Selected work</h2>
        <p class="mt-3 max-w-[52ch] text-lg text-muted">
          Case studies told as problem, approach and outcome. Confidential numbers stay out.
        </p>
      </div>
      <a href="/work/" class="link shrink-0 self-start md:self-auto">All {allIds.length} case studies</a>
    </div>
    <div class="mt-10 border-b border-line">
      {featured.map((entry, i) => <CaseRow entry={entry} index={i} />)}
    </div>
  </section>

  <!-- How I work -->
  <section id="how-i-work" class="wrap mt-28" aria-labelledby="method-heading">
    <div class="grid gap-6 md:grid-cols-12">
      <h2 id="method-heading" class="text-[clamp(2.2rem,1.5rem+2.6vw,3.6rem)] md:col-span-5">How I work</h2>
      <p class="max-w-[52ch] text-lg text-muted md:col-span-6 md:col-start-7 md:pt-3">
        Every project runs through the same four steps, in this order.
      </p>
    </div>
    <ol class="mt-12 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {
        method.map((m, i) => (
          <li class="flex flex-col bg-bg p-6 md:p-8">
            <span class="font-display text-4xl text-accent tabular-nums" aria-hidden="true">{i + 1}</span>
            <h3 class="mt-6 text-xl">{m.name}</h3>
            <p class="mt-2 text-[0.975rem] text-muted">{m.detail}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Tools -->
  <section id="tools" class="wrap mt-28" aria-labelledby="tools-heading">
    <h2 id="tools-heading" class="text-[clamp(1.8rem,1.3rem+1.8vw,2.6rem)]">Tools I use</h2>
    <p class="mt-3 max-w-[56ch] text-muted">The tools behind the work, grouped by what they do.</p>
    <dl class="mt-10 grid gap-8 border-t border-line pt-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        toolGroups.map((g) => (
          <div>
            <dt class="text-sm text-muted">{g.name}</dt>
            <dd class="mt-3 flex flex-col gap-1.5">
              {g.tools.map((t) => (
                <span class="font-display text-xl text-ink/80" style="font-variation-settings:'SOFT' 50">{t}</span>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- About -->
  <section id="about" class="wrap mt-28" aria-labelledby="about-heading">
    <div class="grid gap-10 md:grid-cols-12">
      <figure class="flex flex-col justify-between rounded-2xl border border-line bg-surface p-8 md:col-span-5">
        <blockquote class="font-display text-[clamp(1.5rem,1.2rem+1.2vw,2rem)] leading-snug" style="font-variation-settings:'SOFT' 80">
          <p>"Most 'AI agents' I see are chatbots with extra steps. A chatbot answers. An agent finishes."</p>
        </blockquote>
        <figcaption class="mt-8 text-sm text-muted">
          From a post by Sabin on <a class="link" href={links.linkedin} target="_blank" rel="noopener">LinkedIn<span class="sr-only"> (opens in a new tab)</span></a>
        </figcaption>
      </figure>
      <div class="md:col-span-6 md:col-start-7">
        <h2 id="about-heading" class="text-[clamp(2.2rem,1.5rem+2.6vw,3.6rem)]">About Sabin</h2>
        <p class="mt-5 text-lg">
          I started in IT operations in {profile.experienceSince}, moved into business analysis, and now lead product and growth at Calilio.
        </p>
        <p class="mt-4 text-muted">
          Along the way I stopped handing work off at the spec. I write the design system, plan the help center, run the analysis, build the sales playbooks, make the videos, and build the AI tooling that makes one person work like a small product team.
        </p>
        <a href="/about/" class="btn btn-ghost mt-8">Read the full story</a>
      </div>
    </div>
  </section>

  <Faq items={faqs} />
  <ContactCta />
</Base>
