---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import { services, engagementTypes, method, faqs, profile, disciplines } from '../data/site';
import { absolute, breadcrumbNode } from '../lib/seo';

const schema = [
  {
    '@type': 'WebPage',
    url: absolute(Astro.site, '/services/'),
    name: `Freelance services - ${profile.name}`,
    about: { '@id': absolute(Astro.site, '/#person') },
  },
  {
    '@type': 'OfferCatalog',
    name: `Freelance services by ${profile.name}`,
    itemListElement: services.map((s) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: s.title,
        description: s.answer,
        provider: { '@id': absolute(Astro.site, '/#person') },
        areaServed: 'Worldwide',
      },
    })),
  },
  breadcrumbNode(Astro.site, [
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/services/' },
  ]),
];

const disciplineName = (id: string) => disciplines.find((d) => d.id === id)?.short ?? id;
---

<Base
  title="Freelance services"
  description="Hire Sabin Mainali for product strategy, AI-ready design systems, help center builds, revenue analysis, sales enablement, AI automation and product video."
  ogSlug="services"
  schema={schema}
>
  <section class="wrap pt-16 md:pt-24" aria-labelledby="services-title">
    <div class="grid gap-8 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <h1 id="services-title" class="text-[clamp(2.8rem,1.6rem+4.6vw,5rem)] tracking-[-0.03em]">Services</h1>
        <p class="mt-5 max-w-[58ch] text-lg text-muted">
          I take freelance projects in seven areas. Every project has a written scope, a clear definition of done, and a deliverable that is checked before handover.
        </p>
      </div>
    </div>

    <nav aria-label="Services on this page" class="mt-10">
      <ul class="flex flex-wrap gap-2">
        {
          services.map((s) => (
            <li>
              <a href={`#${s.id}`} class="inline-flex min-h-11 items-center rounded-full border border-line px-4 text-[0.95rem] text-muted transition-colors hover:border-line-strong hover:text-ink">
                {s.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="mt-14 border-b border-line">
      {
        services.map((s) => (
          <section id={s.id} class="grid scroll-mt-24 gap-6 border-t border-line py-10 md:grid-cols-12 md:gap-8 md:py-14" aria-labelledby={`${s.id}-h`}>
            <div class="md:col-span-5">
              <p class="text-sm text-muted">{disciplineName(s.discipline)}</p>
              <h2 id={`${s.id}-h`} class="mt-2 text-[clamp(1.7rem,1.3rem+1.4vw,2.4rem)]">{s.title}</h2>
            </div>
            <div class="md:col-span-7">
              <p class="text-lg">{s.answer}</p>
              <div class="mt-6 grid gap-6 sm:grid-cols-2">
                <div>
                  <h3 class="font-sans text-sm font-medium tracking-normal text-muted">What you get</h3>
                  <ul class="mt-3 space-y-2 text-[0.975rem]">
                    {s.deliverables.map((x) => (
                      <li class="relative pl-4 before:absolute before:left-0 before:top-[0.75em] before:h-px before:w-2 before:bg-accent">{x}</li>
                    ))}
                  </ul>
                </div>
                <div>
                  <h3 class="font-sans text-sm font-medium tracking-normal text-muted">A good fit when</h3>
                  <p class="mt-3 text-[0.975rem]">{s.fit}</p>
                </div>
              </div>
            </div>
          </section>
        ))
      }
    </div>
  </section>

  <section class="wrap mt-28" aria-labelledby="formats-heading">
    <h2 id="formats-heading" class="text-[clamp(2.2rem,1.5rem+2.6vw,3.6rem)]">Ways to work together</h2>
    <p class="mt-3 max-w-[58ch] text-lg text-muted">
      Pick the format that matches the problem. Pricing depends on scope, so every project starts with a short written proposal.
    </p>
    <ul class="mt-10 grid gap-4 md:grid-cols-3">
      {
        engagementTypes.map((e) => (
          <li class="rounded-2xl border border-line bg-surface p-7">
            <h3 class="text-2xl">{e.name}</h3>
            <p class="mt-3 text-muted">{e.detail}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap mt-28" aria-labelledby="process-heading">
    <h2 id="process-heading" class="text-[clamp(2.2rem,1.5rem+2.6vw,3.6rem)]">What happens after you get in touch</h2>
    <ol class="mt-10 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {
        method.map((m, i) => (
          <li class="bg-bg p-6 md:p-8">
            <span class="font-mono text-sm text-accent tabular-nums" aria-hidden="true">0{i + 1}</span>
            <h3 class="mt-6 text-xl">{m.name}</h3>
            <p class="mt-2 text-[0.975rem] text-muted">{m.detail}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <Faq items={faqs} />
</Base>
