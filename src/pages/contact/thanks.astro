---
import Base from '../../layouts/Base.astro';
---

<Base title="Brief sent" description="Your project brief was sent to Sabin Mainali." ogSlug="contact" noindex>
  <section class="wrap flex min-h-[60dvh] flex-col justify-center py-24" aria-labelledby="thanks-title">
    <h1 id="thanks-title" class="text-[clamp(2.6rem,1.6rem+4vw,4.6rem)] tracking-[-0.03em]">Brief sent</h1>
    <p class="mt-5 max-w-[50ch] text-lg text-muted">
      Your project brief was received. I read every brief and reply by email with questions or a proposed scope.
    </p>
    <div class="mt-9 flex flex-wrap gap-3">
      <a href="/work/" class="btn btn-primary">Browse case studies</a>
      <a href="/" class="btn btn-ghost">Back to home</a>
    </div>
  </section>
</Base>
