---
import Base from '../../layouts/Base.astro';
import { profile, links, services } from '../../data/site';
import { absolute, breadcrumbNode } from '../../lib/seo';

const schema = [
  {
    '@type': 'ContactPage',
    url: absolute(Astro.site, '/contact/'),
    name: `Contact ${profile.name}`,
    mainEntity: { '@id': absolute(Astro.site, '/#person') },
  },
  breadcrumbNode(Astro.site, [
    { name: 'Home', path: '/' },
    { name: 'Contact', path: '/contact/' },
  ]),
];

const direct = [
  { label: 'Contra', href: links.contra, text: 'Hire through Contra' },
  { label: 'LinkedIn', href: links.linkedin, text: 'Message on LinkedIn' },
  { label: 'Book a call', href: links.booking, text: 'Pick a time' },
  { label: 'Email', href: links.email ? `mailto:${links.email}` : '', text: links.email },
].filter((d) => d.href);
---

<Base
  title="Contact"
  description="Contact Sabin Mainali about a freelance project in product, design systems, help centers, data analysis, sales enablement, AI automation or video."
  ogSlug="contact"
  schema={schema}
>
  <section class="wrap pt-16 md:pt-24" aria-labelledby="contact-title">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h1 id="contact-title" class="text-[clamp(2.8rem,1.6rem+4.6vw,5rem)] tracking-[-0.03em]">Start a project</h1>
        <p class="mt-6 max-w-[48ch] text-lg text-muted">
          Tell me the problem, the deadline and what done looks like. I reply with questions or a proposed scope before any work starts.
        </p>

        <dl class="mt-10 space-y-5 border-t border-line pt-8">
          <div>
            <dt class="text-sm text-muted">Time zone</dt>
            <dd class="mt-1">{profile.location.timezone}, {profile.location.city}</dd>
          </div>
          {
            direct.map((d) => (
              <div>
                <dt class="text-sm text-muted">{d.label}</dt>
                <dd class="mt-1">
                  <a class="link" href={d.href} target={d.href.startsWith('mailto:') ? undefined : '_blank'} rel="noopener">
                    {d.text}
                    {!d.href.startsWith('mailto:') && <span class="sr-only"> (opens in a new tab)</span>}
                  </a>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="lg:col-span-7">
        <form
          name="contact"
          method="POST"
          action="/contact/thanks/"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="rounded-3xl border border-line bg-surface p-6 md:p-10"
          data-contact-form
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden">
            <label>Leave this field empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>

          <div class="grid gap-6 sm:grid-cols-2">
            <div class="field">
              <label for="name">Your name <span aria-hidden="true" class="text-accent">*</span></label>
              <input id="name" name="name" type="text" autocomplete="name" required maxlength="120" />
              <p id="name-error" class="error" data-error-for="name" hidden>Enter your name so I know who to reply to.</p>
            </div>
            <div class="field">
              <label for="email">Email <span aria-hidden="true" class="text-accent">*</span></label>
              <input id="email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="200" />
              <p id="email-error" class="error" data-error-for="email" hidden>Enter an email address like name@company.com.</p>
            </div>
            <div class="field">
              <label for="company">Company or product <span class="text-muted">(optional)</span></label>
              <input id="company" name="company" type="text" autocomplete="organization" maxlength="160" />
            </div>
            <div class="field">
              <label for="type">What do you need?</label>
              <select id="type" name="project_type">
                <option value="Not sure yet">Not sure yet</option>
                {services.map((s) => <option value={s.title}>{s.title}</option>)}
              </select>
            </div>
            <div class="field sm:col-span-2">
              <label for="timeline">When do you need it?</label>
              <select id="timeline" name="timeline">
                <option value="Flexible">Flexible</option>
                <option value="Within 2 weeks">Within 2 weeks</option>
                <option value="Within a month">Within a month</option>
                <option value="In 1 to 3 months">In 1 to 3 months</option>
              </select>
            </div>
            <div class="field sm:col-span-2">
              <label for="message">The problem you want solved <span aria-hidden="true" class="text-accent">*</span></label>
              <textarea id="message" name="message" rows="6" required minlength="20" maxlength="4000" aria-describedby="message-help"></textarea>
              <p id="message-help" class="help">A few sentences is enough: what is happening now, and what done looks like.</p>
              <p id="message-error" class="error" data-error-for="message" hidden>Describe the problem in at least 20 characters.</p>
            </div>
          </div>

          <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <p class="text-sm text-muted"><span class="text-accent" aria-hidden="true">*</span> Required. Your details are only used to reply to you.</p>
            <button type="submit" class="btn btn-primary" data-submit>Send project brief</button>
          </div>
        </form>
      </div>
    </div>
  </section>
</Base>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .field label {
    font-size: 0.95rem;
    font-weight: 500;
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.7rem 0.9rem;
    border-radius: 0.75rem;
    border: 1px solid var(--line-strong);
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-size: 1rem;
    transition: border-color 200ms ease, box-shadow 200ms ease;
  }
  .field textarea {
    resize: vertical;
  }
  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .field [aria-invalid='true'] {
    border-color: #e5484d;
  }
  .help {
    font-size: 0.875rem;
    color: var(--muted);
  }
  .error {
    font-size: 0.875rem;
    color: #d93036;
  }
  :global([data-theme='dark']) .error {
    color: #ff8f8f;
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  if (form) {
    // Custom inline errors replace native bubbles only when this script runs.
    form.noValidate = true;
    const fields = ['name', 'email', 'message']
      .map((id) => form.querySelector<HTMLInputElement | HTMLTextAreaElement>(`#${id}`))
      .filter((f): f is HTMLInputElement | HTMLTextAreaElement => Boolean(f));

    const check = (field: HTMLInputElement | HTMLTextAreaElement) => {
      const trimmed = field.value.trim();
      const min = field instanceof HTMLTextAreaElement ? field.minLength : 0;
      const valid = field.checkValidity() && trimmed.length > 0 && trimmed.length >= Math.max(min, 0);
      const error = form.querySelector<HTMLElement>(`[data-error-for="${field.id}"]`);
      field.setAttribute('aria-invalid', valid ? 'false' : 'true');
      if (error) {
        error.hidden = valid;
        const ids = (field.getAttribute('aria-describedby') || '').split(' ').filter((id) => id && id !== error.id);
        if (!valid) ids.push(error.id);
        if (ids.length) field.setAttribute('aria-describedby', ids.join(' '));
        else field.removeAttribute('aria-describedby');
      }
      return valid;
    };

    fields.forEach((f) => {
      f.addEventListener('blur', () => {
        if (f.value.length > 0) check(f);
      });
      f.addEventListener('input', () => {
        if (f.getAttribute('aria-invalid') === 'true') check(f);
      });
    });

    form.addEventListener('submit', (e) => {
      const invalid = fields.filter((f) => !check(f));
      if (invalid.length > 0) {
        e.preventDefault();
        invalid[0].focus();
        return;
      }
      const button = form.querySelector<HTMLButtonElement>('[data-submit]');
      if (button) {
        button.disabled = true;
        button.textContent = 'Sending...';
      }
    });

    // Restore the button if the page is shown again from the back-forward cache.
    window.addEventListener('pageshow', () => {
      const button = form.querySelector<HTMLButtonElement>('[data-submit]');
      if (button) {
        button.disabled = false;
        button.textContent = 'Send project brief';
      }
    });
  }
</script>
