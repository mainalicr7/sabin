---
// Small motion graphics that illustrate what a tile is about. Decorative only (aria-hidden).
// Loops start when the parent card is revealed (.is-in) and stop under reduced motion.
interface Props {
  kind: 'radar' | 'tracker' | 'flow' | 'spark' | 'swatches' | 'checks' | 'funnel';
  class?: string;
}
const { kind, class: className = '' } = Astro.props;
---

<div class:list={['mini', `mini-${kind}`, className]} aria-hidden="true">
  {
    kind === 'radar' && (
      <div class="radar">
        <span class="radar-sweep" />
        <span class="blip" style="--x:68%;--y:30%;--d:0.35s" />
        <span class="blip" style="--x:28%;--y:62%;--d:1.6s" />
        <span class="blip" style="--x:74%;--y:70%;--d:2.5s" />
      </div>
    )
  }

  {
    kind === 'tracker' && (
      <div class="tracker">
        {['New', 'Follow-up', 'Won'].map((lane) => (
          <div class="lane">
            <span class="lane-label">{lane}</span>
            <span class="card" />
            <span class="card short" />
          </div>
        ))}
        <span class="card mover" />
      </div>
    )
  }

  {
    kind === 'flow' && (
      <svg viewBox="0 0 240 84" class="flow">
        <path class="flow-line" d="M34 34 H206" />
        <circle class="flow-node n1" cx="34" cy="34" r="13" />
        <circle class="flow-node n2" cx="120" cy="34" r="13" />
        <circle class="flow-node n3" cx="206" cy="34" r="13" />
        <circle class="flow-dot" cx="34" cy="34" r="4" />
        <text x="34" y="74">Trigger</text>
        <text x="120" y="74">Transform</text>
        <text x="206" y="74">Notify</text>
      </svg>
    )
  }

  {
    kind === 'spark' && (
      <svg viewBox="0 0 240 70" class="spark">
        <path class="spark-area" d="M0 58 C30 52 40 40 64 44 S104 22 128 30 S170 12 196 18 S228 6 240 8 V70 H0 Z" />
        <path class="spark-line" pathLength="1" d="M0 58 C30 52 40 40 64 44 S104 22 128 30 S170 12 196 18 S228 6 240 8" />
      </svg>
    )
  }

  {
    kind === 'swatches' && (
      <div class="swatches">
        <span style="--c:var(--accent)" />
        <span style="--c:var(--text)" />
        <span style="--c:var(--muted)" />
        <span style="--c:var(--line-strong)" />
        <span style="--c:var(--surface-2)" />
        <b>Aa</b>
      </div>
    )
  }

  {
    kind === 'funnel' && (
      <div class="funnel">
        {[
          ['Leads', 100],
          ['Contacted', 74],
          ['Qualified', 48],
          ['Won', 26],
        ].map(([label, w], i) => (
          <div class="funnel-row" style={`--i:${i}`}>
            <span class="funnel-label">{label}</span>
            <span class="funnel-bar" style={`--w:${w}%`} />
          </div>
        ))}
      </div>
    )
  }

  {
    kind === 'checks' && (
      <ul class="checks">
        {[78, 62, 70].map((w, i) => (
          <li style={`--i:${i}`}>
            <span class="tick" />
            <span class="bar" style={`width:${w}%`} />
          </li>
        ))}
      </ul>
    )
  }
</div>

<style>
  .mini {
    --run: paused;
    color: var(--muted);
  }
  :global(.is-in) .mini,
  :global(html:not(.js)) .mini {
    --run: running;
  }

  /* Radar: a sweep that lights up blips as it passes. */
  .radar {
    position: relative;
    width: 6.5rem;
    aspect-ratio: 1;
    border-radius: 999px;
    border: 1px solid var(--line);
    background:
      radial-gradient(circle, transparent 32%, var(--line) 32.5%, transparent 33.5%),
      radial-gradient(circle, transparent 64%, var(--line) 64.5%, transparent 65.5%),
      linear-gradient(var(--line), var(--line)) center / 1px 100% no-repeat,
      linear-gradient(var(--line), var(--line)) center / 100% 1px no-repeat;
    overflow: hidden;
  }
  .radar-sweep {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: conic-gradient(from 0deg, color-mix(in srgb, var(--accent) 45%, transparent), transparent 70deg);
    animation: spin 3.2s linear infinite var(--run);
  }
  .blip {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 6px;
    height: 6px;
    margin: -3px;
    border-radius: 999px;
    background: var(--accent);
    opacity: 0;
    animation: blip 3.2s ease-out infinite var(--run);
    animation-delay: var(--d);
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes blip {
    0% {
      opacity: 1;
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 60%, transparent);
    }
    40% {
      opacity: 0.6;
      box-shadow: 0 0 0 8px transparent;
    }
    100% {
      opacity: 0;
    }
  }

  /* Tracker: a lead card moves lane to lane. */
  .tracker {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    width: 100%;
    max-width: 17rem;
  }
  .lane {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.45rem;
    border-radius: 0.6rem;
    background: var(--surface-2);
    min-height: 5.2rem;
  }
  .lane-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--muted);
  }
  .card {
    height: 0.9rem;
    border-radius: 0.3rem;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .card.short {
    width: 70%;
  }
  .card.mover {
    position: absolute;
    left: 0.45rem;
    bottom: 0.45rem;
    width: calc((100% - 1rem) / 3 - 0.9rem);
    background: var(--accent);
    border-color: var(--accent);
    animation: lanes 6s cubic-bezier(0.65, 0, 0.35, 1) infinite var(--run);
  }
  @keyframes lanes {
    0%,
    22% {
      transform: translateX(0);
    }
    33%,
    55% {
      transform: translateX(calc(100% + 1.4rem));
    }
    66%,
    92% {
      transform: translateX(calc(200% + 2.8rem));
    }
    100% {
      transform: translateX(calc(200% + 2.8rem));
      opacity: 0;
    }
  }

  /* Flow: a packet travels trigger to notify; nodes light as it passes. */
  .flow {
    width: 100%;
    max-width: 16rem;
    overflow: visible;
  }
  .flow-line {
    stroke: var(--line-strong);
    stroke-width: 1.5;
    stroke-dasharray: 4 4;
    fill: none;
  }
  .flow-node {
    fill: var(--surface);
    stroke: var(--line-strong);
    stroke-width: 1.5;
    animation: node 3s ease-in-out infinite var(--run);
  }
  .n2 {
    animation-delay: 0.9s;
  }
  .n3 {
    animation-delay: 1.8s;
  }
  .flow-dot {
    fill: var(--accent);
    animation: packet 3s ease-in-out infinite var(--run);
  }
  .flow text {
    font-family: var(--font-mono);
    font-size: 10px;
    fill: var(--muted);
    text-anchor: middle;
  }
  @keyframes packet {
    0% {
      transform: translateX(0);
      opacity: 0;
    }
    8% {
      opacity: 1;
    }
    62% {
      transform: translateX(172px);
      opacity: 1;
    }
    72%,
    100% {
      transform: translateX(172px);
      opacity: 0;
    }
  }
  @keyframes node {
    0%,
    100% {
      stroke: var(--line-strong);
    }
    8%,
    22% {
      stroke: var(--accent);
      fill: var(--accent-soft);
    }
  }

  /* Sparkline draws in when the card appears. */
  .spark {
    width: 100%;
    height: auto;
    max-height: 4.25rem;
  }
  .spark-line {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1400ms var(--ease-out-soft) 200ms;
  }
  .spark-area {
    fill: var(--accent-soft);
    opacity: 0;
    transition: opacity 900ms ease 700ms;
  }
  :global(.is-in) .spark-line,
  :global(html:not(.js)) .spark-line {
    stroke-dashoffset: 0;
  }
  :global(.is-in) .spark-area,
  :global(html:not(.js)) .spark-area {
    opacity: 1;
  }

  /* Swatches fan out on card hover. */
  .swatches {
    display: flex;
    align-items: center;
  }
  .swatches span {
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 999px;
    background: var(--c);
    border: 2px solid var(--surface);
    margin-left: -0.55rem;
    transition: margin 420ms var(--ease-out-soft), transform 420ms var(--ease-out-soft);
  }
  .swatches span:first-child {
    margin-left: 0;
  }
  .swatches b {
    margin-left: 0.9rem;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.02em;
    transition: transform 420ms var(--ease-out-soft);
  }
  :global(.group:hover) .swatches span {
    margin-left: 0.3rem;
  }
  :global(.group:hover) .swatches span:first-child {
    margin-left: 0;
  }
  :global(.group:hover) .swatches b {
    transform: translateX(0.25rem);
  }

  /* Checklist ticks in, one line after another. */
  .checks {
    display: grid;
    gap: 0.55rem;
    width: 100%;
    max-width: 15rem;
  }
  .checks li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .tick {
    position: relative;
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 999px;
    border: 1.5px solid var(--line-strong);
    transition: background-color 300ms ease, border-color 300ms ease;
    transition-delay: calc(400ms + var(--i) * 350ms);
  }
  .tick::after {
    content: '';
    position: absolute;
    left: 0.32rem;
    top: 0.14rem;
    width: 0.3rem;
    height: 0.55rem;
    border: solid var(--on-accent);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg) scale(0);
    transition: transform 360ms var(--ease-out-soft);
    transition-delay: calc(480ms + var(--i) * 350ms);
  }
  .bar {
    height: 0.5rem;
    border-radius: 999px;
    background: var(--surface-2);
  }
  :global(.is-in) .tick,
  :global(html:not(.js)) .tick {
    background: var(--accent);
    border-color: var(--accent);
  }
  :global(.is-in) .tick::after,
  :global(html:not(.js)) .tick::after {
    transform: rotate(45deg) scale(1);
  }

  /* Funnel: stage bars grow in order when the card appears. Widths are illustrative shapes, not data. */
  .funnel {
    display: grid;
    gap: 0.35rem;
    width: 100%;
  }
  .funnel-row {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    align-items: center;
    gap: 0.6rem;
  }
  .funnel-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--muted);
  }
  .funnel-bar {
    height: 0.55rem;
    width: var(--w);
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) calc(35% + var(--i) * 20%), var(--surface-2));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 900ms var(--ease-out-soft);
    transition-delay: calc(250ms + var(--i) * 140ms);
  }
  :global(.is-in) .funnel-bar,
  :global(html:not(.js)) .funnel-bar {
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .mini * {
      animation: none !important;
    }
    .blip {
      opacity: 0.8;
    }
    .flow-dot {
      transform: translateX(86px);
    }
    .card.mover {
      transform: translateX(calc(100% + 1.4rem));
    }
  }
</style>
