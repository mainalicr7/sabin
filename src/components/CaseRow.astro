---
import type { CollectionEntry } from 'astro:content';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import { disciplines } from '../data/site';

interface Props {
  entry: CollectionEntry<'work'>;
  index: number;
  headingLevel?: 'h2' | 'h3';
}

const { entry, index, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const tags = entry.data.disciplines.map((id) => disciplines.find((d) => d.id === id)?.short ?? id);
const number = String(index + 1).padStart(2, '0');
---

<article
  class="case-row group relative grid gap-3 border-t border-line py-8 transition-colors duration-300 md:grid-cols-12 md:gap-8 md:py-10"
  data-reveal
  data-disciplines={entry.data.disciplines.join(' ')}
  data-outcome={entry.data.outcome}
>
  <p class="font-mono text-sm text-muted tabular-nums md:col-span-1 md:pt-2" aria-hidden="true">{number}</p>
  <div class="md:col-span-7">
    <Heading class="text-[clamp(1.5rem,1.1rem+1.6vw,2.25rem)] transition-[color,transform] duration-300 ease-out group-hover:translate-x-1.5 group-hover:text-accent">
      <a href={`/work/${entry.id}/`} class="after:absolute after:inset-0 after:content-['']">
        {entry.data.title}
        <ArrowUpRight class="ml-1 inline size-[0.8em] -translate-x-2 align-baseline opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100" stroke-width={2} aria-hidden="true" />
      </a>
    </Heading>
    <p class="mt-3 max-w-[60ch] text-muted">{entry.data.summary}</p>
  </div>
  <div class="md:col-span-4 md:pt-2">
    <p class="text-sm text-muted">{entry.data.context}</p>
    <ul class="mt-3 flex flex-wrap gap-2" aria-label="Disciplines">
      {tags.map((t) => <li class="rounded-full border border-line px-3 py-1 text-[0.8rem] text-muted">{t}</li>)}
    </ul>
  </div>
</article>
