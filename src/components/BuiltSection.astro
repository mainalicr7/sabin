---
import { Image } from 'astro:assets';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import MessageSquareText from '@lucide/astro/icons/message-square-text';
import Globe from '@lucide/astro/icons/globe';
import Radar from '@lucide/astro/icons/radar';
import ScanSearch from '@lucide/astro/icons/scan-search';
import Kanban from '@lucide/astro/icons/kanban';
import FilePenLine from '@lucide/astro/icons/file-pen-line';
import AudioLines from '@lucide/astro/icons/audio-lines';
import Workflow from '@lucide/astro/icons/workflow';
import MiniVisual from './MiniVisual.astro';
import { projects } from '../data/site';
import chatonicsShot from '../assets/chatonics-product.png';
import yoddhaShot from '../assets/yoddhalab-site.png';

const icons = {
  chat: MessageSquareText,
  web: Globe,
  radar: Radar,
  extract: ScanSearch,
  tracker: Kanban,
  writing: FilePenLine,
  voice: AudioLines,
  flow: Workflow,
};
const visuals = {
  chat: 'radar',
  web: 'radar',
  radar: 'radar',
  extract: 'extract',
  tracker: 'tracker',
  writing: 'typing',
  voice: 'wave',
  flow: 'flow',
} as const;

const chatonics = projects.find((p) => p.id === 'chatonics')!;
const yoddha = projects.find((p) => p.id === 'yoddhalab-website')!;
const tools = projects.filter((p) => !p.url);
const ChatIcon = icons[chatonics.icon];
const WebIcon = icons[yoddha.icon];
---

<section id="built" class="wrap mt-24" aria-labelledby="built-heading">
  <h2 id="built-heading" class="text-[clamp(2.1rem,1.4rem+2.4vw,3.25rem)]" data-reveal>Things I have built</h2>
  <p class="mt-4 max-w-[58ch] text-lg text-muted" data-reveal style="--i:1">
    Products, websites and internal tools I have designed and built, from a live SaaS product to the automations that run a team's week.
  </p>

  <!-- Chatonics: text left, product right -->
  <article class="spotlight mt-12 grid overflow-hidden rounded-2xl border border-line bg-surface lg:grid-cols-12" data-reveal>
    <div class="flex flex-col p-7 md:p-10 lg:col-span-5">
      <div class="flex items-center gap-3">
        <span class="grid size-11 place-items-center rounded-xl bg-accent text-on-accent">
          <ChatIcon class="size-5" stroke-width={1.5} aria-hidden="true" />
        </span>
        <p class="text-sm text-muted">{chatonics.kind}</p>
      </div>
      <h3 class="mt-7 text-[clamp(1.9rem,1.5rem+1.4vw,2.6rem)]">{chatonics.name}</h3>
      <p class="mt-3 text-muted">{chatonics.summary}</p>
      <ul class="mt-7 flex flex-wrap gap-1.5" aria-label="Chatonics features">
        {chatonics.features.map((f) => <li class="rounded-full border border-line px-2.5 py-1 text-[0.8125rem] text-muted">{f}</li>)}
      </ul>
      <div class="mt-auto flex flex-wrap gap-3 pt-9">
        <a href={`/work/${chatonics.caseStudy}/`} class="btn btn-primary">Read case study</a>
        <a href={chatonics.url} class="btn btn-ghost" target="_blank" rel="noopener">
          Visit site<ArrowUpRight class="btn-icon size-4" stroke-width={1.75} aria-hidden="true" />
          <span class="sr-only"> chatonics.com (opens in a new tab)</span>
        </a>
      </div>
    </div>
    <div class="relative flex items-center overflow-hidden border-t border-line bg-accent-soft p-5 sm:p-8 lg:col-span-7 lg:border-t-0 lg:border-l lg:p-10">
      <div class="dot-grid pointer-events-none absolute inset-0 [mask-image:radial-gradient(ellipse_at_center,black,transparent_75%)]" aria-hidden="true"></div>
      <Image
        src={chatonicsShot}
        alt="The Chatonics shared inbox with channel filters, a customer conversation and AI reply controls, shown with demo data."
        widths={[560, 840, 1135]}
        sizes="(min-width: 1024px) 640px, 100vw"
        loading="lazy"
        class="settle relative w-full rounded-xl border border-line shadow-[0_30px_60px_-30px_rgb(20_30_80/0.45)]"
      />
    </div>
  </article>

  <!-- Yoddha Lab website: site in a browser frame on the left, text right -->
  <article class="spotlight mt-4 grid overflow-hidden rounded-2xl border border-line bg-surface lg:grid-cols-12" data-reveal>
    <div class="relative order-2 flex items-center overflow-hidden border-t border-line bg-surface-2 p-5 sm:p-8 lg:order-1 lg:col-span-7 lg:border-t-0 lg:border-r lg:p-10">
      <figure class="settle relative w-full overflow-hidden rounded-xl border border-line bg-surface shadow-[0_30px_60px_-30px_rgb(0_0_0/0.45)]">
        <div class="flex items-center gap-2 border-b border-line px-4 py-2.5" aria-hidden="true">
          <span class="size-2.5 rounded-full bg-line-strong"></span>
          <span class="size-2.5 rounded-full bg-line-strong"></span>
          <span class="size-2.5 rounded-full bg-line-strong"></span>
          <span class="ml-3 truncate rounded-full bg-surface-2 px-3 py-0.5 font-mono text-[0.6875rem] text-muted">yoddhalab.com</span>
        </div>
        <Image
          src={yoddhaShot}
          alt="The Yoddha Lab homepage hero with the headline Innovate. Protect. Excel., service highlights and consultation buttons."
          widths={[560, 840, 1425]}
          sizes="(min-width: 1024px) 640px, 100vw"
          loading="lazy"
          class="w-full"
        />
      </figure>
    </div>
    <div class="order-1 flex flex-col p-7 md:p-10 lg:order-2 lg:col-span-5">
      <div class="flex items-center gap-3">
        <span class="grid size-11 place-items-center rounded-xl border border-line text-ink">
          <WebIcon class="size-5" stroke-width={1.5} aria-hidden="true" />
        </span>
        <p class="text-sm text-muted">{yoddha.kind}</p>
      </div>
      <h3 class="mt-7 text-[clamp(1.7rem,1.4rem+1.1vw,2.3rem)]">{yoddha.name}</h3>
      <p class="mt-3 text-muted">{yoddha.summary}</p>
      <ul class="mt-7 flex flex-wrap gap-1.5" aria-label="Website sections">
        {yoddha.features.map((f) => <li class="rounded-full border border-line px-2.5 py-1 text-[0.8125rem] text-muted">{f}</li>)}
      </ul>
      <div class="mt-auto pt-9">
        <a href={yoddha.url} class="btn btn-ghost" target="_blank" rel="noopener">
          Visit site<ArrowUpRight class="btn-icon size-4" stroke-width={1.75} aria-hidden="true" />
          <span class="sr-only"> yoddhalab.com (opens in a new tab)</span>
        </a>
      </div>
    </div>
  </article>

  <!-- Tools and automations -->
  <ul class="mt-4 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    {
      tools.map((p, i) => {
        const Icon = icons[p.icon];
        return (
          <li class="spotlight lift flex flex-col rounded-2xl border border-line bg-surface p-7" data-reveal style={`--i:${i % 3}`}>
            <div class="flex items-center justify-between">
              <span class="grid size-11 place-items-center rounded-xl border border-line text-ink">
                <Icon class="size-5" stroke-width={1.5} aria-hidden="true" />
              </span>
              <span class="text-[0.8125rem] text-muted">{p.kind}</span>
            </div>
            <div class="mt-6 grid h-32 place-items-center overflow-hidden rounded-xl border border-line bg-bg px-4">
              <MiniVisual kind={visuals[p.icon]} class="grid w-full place-items-center" />
            </div>
            <h3 class="mt-6 text-xl">{p.name}</h3>
            <p class="mt-2 text-[0.9375rem] text-muted">{p.summary}</p>
          </li>
        );
      })
    }
  </ul>
</section>
