---
interface Props {
  items: { q: string; a: string }[];
  id?: string;
}
const { items, id = 'faq' } = Astro.props;
---

<section class="wrap mt-28" aria-labelledby={`${id}-heading`} id={id}>
  <div class="grid gap-10 md:grid-cols-12">
    <div class="md:col-span-4">
      <h2 id={`${id}-heading`} class="text-[clamp(2rem,1.4rem+2vw,3rem)]">Questions clients ask</h2>
      <p class="mt-3 text-muted">Short answers about how I work with freelance clients.</p>
    </div>
    <div class="md:col-span-8">
      {
        items.map((f) => (
          <details class="faq group border-t border-line last:border-b" data-reveal>
            <summary class="flex min-h-14 list-none items-center justify-between gap-6 py-5 text-lg [&::-webkit-details-marker]:hidden">
              <span class="faq-q font-medium">{f.q}</span>
              <span class="faq-mark relative size-4 shrink-0" aria-hidden="true" />
            </summary>
            <p class="max-w-[62ch] pb-6 text-muted">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-mark::before,
  .faq-mark::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1.5px;
    background: currentColor;
    transition: transform 240ms var(--ease-out-soft);
  }
  .faq-mark::after {
    transform: rotate(90deg);
  }
  .faq[open] .faq-mark::after {
    transform: rotate(0deg);
  }
  .faq summary:hover .faq-q {
    color: var(--accent);
  }
  .faq-q {
    transition: color 200ms ease;
  }
  /* Smooth height animation where ::details-content is supported; instant elsewhere. */
  .faq {
    interpolate-size: allow-keywords;
  }
  .faq::details-content {
    block-size: 0;
    overflow: hidden;
    transition: block-size 420ms var(--ease-out-soft), content-visibility 420ms allow-discrete;
  }
  .faq[open]::details-content {
    block-size: auto;
  }
  .faq > p {
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity 320ms ease 60ms, transform 420ms var(--ease-out-soft);
  }
  .faq[open] > p {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .faq > p {
      opacity: 1;
      transform: none;
    }
  }
</style>
