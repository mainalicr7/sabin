---
// A simple, accessible process diagram: an ordered list drawn as connected steps.
interface Props {
  steps: { title: string; detail: string }[];
  label: string;
}
const { steps, label } = Astro.props;
---

<figure class="not-article my-10">
  <ol class="grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4" aria-label={label}>
    {
      steps.map((s, i) => (
        <li class="flex flex-col gap-2 bg-surface p-5">
          <span class="font-mono text-[0.8125rem] text-accent tabular-nums" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span class="text-base font-semibold leading-snug">{s.title}</span>
          <span class="text-[0.95rem] leading-relaxed text-muted">{s.detail}</span>
        </li>
      ))
    }
  </ol>
  <figcaption class="mt-3 text-sm text-muted">{label}</figcaption>
</figure>

<style>
  figure :global(ol) {
    list-style: none !important;
    padding-left: 0 !important;
    margin-bottom: 0 !important;
  }
  figure :global(li) {
    margin-bottom: 0 !important;
    padding-left: 1.25rem !important;
  }
</style>
