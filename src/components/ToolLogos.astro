---
// Tool marquee with real brand marks from Simple Icons, in one neutral color.
// The list renders twice for a seamless loop; the copy is hidden from assistive tech.
import { siClaude, siN8n, siGoogle, siPython, siR, siStripe, siBrevo, siGit, siDocker, siCloudflare } from 'simple-icons';

const tools = [
  { icon: siClaude, name: 'Claude Code' },
  { icon: siN8n, name: 'n8n' },
  { icon: siGoogle, name: 'Google Stitch' },
  { icon: siPython, name: 'Python' },
  { icon: siR, name: 'R' },
  { icon: siStripe, name: 'Stripe' },
  { icon: siBrevo, name: 'Brevo' },
  { icon: siGit, name: 'Git' },
  { icon: siDocker, name: 'Docker' },
  { icon: siCloudflare, name: 'Cloudflare' },
];
---

<div class="marquee" data-reveal>
  {
    [false, true].map((copy) => (
      <ul class="marquee-track" aria-label={copy ? undefined : 'Tools'} aria-hidden={copy ? 'true' : undefined}>
        {tools.map((t) => (
          <li class="flex items-center gap-3 rounded-full border border-line bg-surface py-2.5 pr-5 pl-3 whitespace-nowrap">
            <svg viewBox="0 0 24 24" class="size-5 fill-current text-muted" aria-hidden="true">
              <path d={t.icon.path} />
            </svg>
            <span class="text-[0.9375rem]">{t.name}</span>
          </li>
        ))}
      </ul>
    ))
  }
</div>
