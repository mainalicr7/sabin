---
import { profile, links } from '../data/site';

interface Props {
  heading?: string;
}
const { heading = 'Have a product, content or AI problem to solve?' } = Astro.props;
---

<section class="wrap mt-28" aria-labelledby="cta-heading">
  <div class="grid gap-8 rounded-3xl border border-line bg-surface p-8 md:grid-cols-12 md:p-14">
    <div class="md:col-span-8">
      {
        profile.availability.open && (
          <p class="flex items-center gap-2 text-sm text-muted">
            <span class="inline-flex size-2 rounded-full bg-emerald-500" aria-hidden="true" />
            {profile.availability.label}
          </p>
        )
      }
      <h2 id="cta-heading" class="mt-4 text-[clamp(1.9rem,1.3rem+2.2vw,3rem)]">{heading}</h2>
      <p class="mt-4 max-w-[52ch] text-muted">
        Send a short brief: the problem, the deadline and what done looks like. I reply with questions or a proposed scope before any work starts.
      </p>
    </div>
    <div class="flex flex-col items-start justify-end gap-4 md:col-span-4 md:items-end">
      <a href={links.contra || '/contact/'} class="btn btn-primary" {...(links.contra ? { target: '_blank', rel: 'noopener' } : {})}>
        Hire me{links.contra && <span class="sr-only"> on Contra (opens in a new tab)</span>}
      </a>
      <p class="text-sm text-muted">
        or <a class="link" href={links.linkedin} target="_blank" rel="noopener">message on LinkedIn<span class="sr-only"> (opens in a new tab)</span></a>
      </p>
    </div>
  </div>
</section>
