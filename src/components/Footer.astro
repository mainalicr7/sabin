---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import ArrowUp from '@lucide/astro/icons/arrow-up';
import { profile, links, projects } from '../data/site';

const year = new Date().getFullYear();
const chatonics = projects.find((p) => p.id === 'chatonics');

const columns = [
  {
    title: 'Explore',
    items: [
      { href: '/work/', label: 'Work' },
      { href: '/services/', label: 'Services' },
      { href: '/ai-lab/', label: 'AI Lab' },
      { href: '/about/', label: 'About' },
    ],
  },
  {
    title: 'Work with me',
    items: [
      { href: '/contact/', label: 'Contact' },
      { href: '/cv/', label: 'CV' },
      { href: '/work/chatonics/', label: 'Chatonics case study' },
    ],
  },
  {
    title: 'Elsewhere',
    items: [
      { href: links.contra, label: 'Contra', external: true },
      { href: links.linkedin, label: 'LinkedIn', external: true },
      { href: chatonics?.url ?? '', label: 'chatonics.com', external: true },
      { href: links.github, label: 'GitHub', external: true },
    ].filter((l) => l.href),
  },
];
---

<footer class="relative mt-28 overflow-hidden border-t border-line bg-surface">
  <div class="footer-glow pointer-events-none absolute -top-40 left-1/2 h-80 w-[60rem] max-w-full -translate-x-1/2 rounded-full" aria-hidden="true"></div>

  <div class="wrap relative grid gap-14 pt-20 pb-12 lg:grid-cols-12">
    <div class="lg:col-span-6" data-reveal>
      {
        profile.availability.open && (
          <p class="flex items-center gap-2 text-sm text-muted">
            <span class="inline-flex size-2 rounded-full bg-emerald-500" aria-hidden="true" />
            {profile.availability.label}
          </p>
        )
      }
      <p class="mt-5 font-display text-[clamp(2rem,1.3rem+2.8vw,3.4rem)] leading-[1.02] font-extrabold tracking-[-0.02em]">
        Have a product, content or AI problem? Let us build the system.
      </p>
      <a href="/contact/" class="btn btn-primary mt-8">
        Hire me<ArrowUpRight class="btn-icon size-4" stroke-width={1.75} aria-hidden="true" />
      </a>
    </div>

    <nav aria-label="Footer" class="grid grid-cols-2 gap-10 sm:grid-cols-3 lg:col-span-6 lg:pt-3">
      {
        columns.map((col, i) => (
          <div data-reveal style={`--i:${i + 1}`}>
            <h2 class="font-sans text-sm font-medium tracking-normal text-muted">{col.title}</h2>
            <ul class="mt-4 space-y-3">
              {col.items.map((item) => (
                <li>
                  <a
                    class="footer-link group inline-flex items-center gap-1 text-[0.975rem]"
                    href={item.href}
                    {...('external' in item && item.external ? { target: '_blank', rel: 'me noopener' } : {})}
                  >
                    <span class="link link-draw">{item.label}</span>
                    {'external' in item && item.external && (
                      <>
                        <ArrowUpRight class="size-3.5 text-muted transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-accent" stroke-width={1.75} aria-hidden="true" />
                        <span class="sr-only"> (opens in a new tab)</span>
                      </>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <div class="wrap relative">
    <p class="footer-wordmark select-none font-display font-extrabold leading-[0.8] tracking-[-0.045em]" aria-hidden="true" data-reveal>
      Sabin Mainali
    </p>
  </div>

  <div class="relative border-t border-line">
    <div class="wrap flex flex-col gap-4 py-6 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} {profile.name}. {profile.location.city}, {profile.location.country}.</p>
      <a href="#main" class="group inline-flex items-center gap-2 self-start rounded-full border border-line px-4 py-2 text-ink transition-colors hover:border-ink sm:self-auto" data-back-to-top>
        Back to top
        <ArrowUp class="size-4 transition-transform duration-300 group-hover:-translate-y-0.5" stroke-width={1.75} aria-hidden="true" />
      </a>
    </div>
  </div>
</footer>

<style>
  .footer-glow {
    background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 22%, transparent), transparent);
    opacity: 0.7;
  }
  /* Oversized name that fills the footer width and fades into the bottom edge. */
  .footer-wordmark {
    font-size: clamp(3rem, 14vw, 13.25rem);
    white-space: nowrap;
    margin-bottom: -0.12em;
    background: linear-gradient(to bottom, var(--text) 10%, color-mix(in srgb, var(--text) 8%, transparent) 95%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
</style>

<script>
  document.querySelector('[data-back-to-top]')?.addEventListener('click', (e) => {
    e.preventDefault();
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
    document.getElementById('main')?.focus({ preventScroll: true });
  });
</script>
