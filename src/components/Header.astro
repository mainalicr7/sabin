---
import Sun from '@lucide/astro/icons/sun';
import Moon from '@lucide/astro/icons/moon';

const nav = [
  { href: '/work/', label: 'Work' },
  { href: '/services/', label: 'Services' },
  { href: '/ai-lab/', label: 'AI Lab' },
  { href: '/about/', label: 'About' },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
const current = (href: string) => (path === href ? 'page' : isCurrent(href) ? 'true' : undefined);
const mobileNav = [...nav, { href: '/contact/', label: 'Contact' }];
---

<header class="site-header sticky top-0 z-50 border-b border-transparent bg-bg/80 backdrop-blur-md transition-[border-color] duration-300" data-header>
  <div class="wrap flex h-16 items-center justify-between gap-4">
    <a href="/" class="brand flex items-center gap-2.5 no-underline">
      <!-- Route S: one path from an open idea ring, through a milestone, to a shipped accent dot. -->
      <svg class="brand-mark" viewBox="0 0 40 40" width="34" height="34" aria-hidden="true" focusable="false">
        <rect class="brand-tile" width="40" height="40" rx="11" />
        <rect class="brand-edge" x="0.5" y="0.5" width="39" height="39" rx="10.5" />
        <g class="brand-grid">
          <circle cx="8" cy="8" r="0.9" /><circle cx="8" cy="20" r="0.9" /><circle cx="8" cy="32" r="0.9" />
          <circle cx="32" cy="20" r="0.9" /><circle cx="32" cy="32" r="0.9" />
        </g>
        <path class="brand-route" pathLength="1" d="M25.63 10.25 A6.5 6.5 0 1 0 20 20 A6.5 6.5 0 1 1 14.37 29.75" />
        <circle class="brand-milestone" cx="20" cy="20" r="1.1" />
        <circle class="brand-start" cx="25.63" cy="10.25" r="2.3" />
        <circle class="brand-end" cx="14.37" cy="29.75" r="3.3" />
      </svg>
      <span class="font-display text-[1.15rem] font-bold tracking-[-0.01em]">Sabin Mainali</span>
    </a>

    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-1 text-[0.9375rem]">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['nav-link relative isolate rounded-full px-3.5 py-2 transition-colors duration-200 hover:text-ink', isCurrent(item.href) ? 'text-ink' : 'text-muted']}
                aria-current={current(item.href)}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-1.5">
      <button
        type="button"
        data-theme-toggle
        class="relative inline-flex size-11 items-center justify-center rounded-full text-muted transition-colors hover:text-ink"
        aria-label="Switch to light theme"
      >
        <Sun class="theme-icon theme-icon-sun absolute size-[1.15rem]" aria-hidden="true" stroke-width={1.75} />
        <Moon class="theme-icon theme-icon-moon absolute size-[1.15rem]" aria-hidden="true" stroke-width={1.75} />
      </button>
      <a href="/contact/" class="btn btn-primary hidden !min-h-10 !px-4 !text-[0.9rem] sm:inline-flex">Hire me</a>

      <button
        type="button"
        class="relative inline-flex size-11 items-center justify-center rounded-full md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-button
      >
        <span class="sr-only" data-menu-label>Open menu</span>
        <span class="menu-bars" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu absolute inset-x-0 top-full border-b border-line bg-bg shadow-[0_24px_40px_-24px_rgb(0_0_0/0.35)] md:hidden" data-menu hidden>
    <nav aria-label="Mobile" class="wrap">
      <div class="pb-6">
        <ul class="border-t border-line pt-2">
          {
            mobileNav.map((item, i) => (
              <li style={`--i:${i}`}>
                <a
                  href={item.href}
                  class:list={['flex min-h-14 items-center border-b border-line font-display text-2xl font-bold tracking-[-0.01em]', isCurrent(item.href) ? 'text-accent' : 'text-ink']}
                  aria-current={current(item.href)}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a href="/contact/" class="btn btn-primary mt-6 w-full" style={`--i:${mobileNav.length}`}>Hire me</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header.is-scrolled {
    border-color: var(--line);
  }

  /* Route S mark. On hover the route redraws from the idea ring and lands on the shipped dot. */
  .brand-mark {
    flex: none;
    width: 2.125rem;
    height: 2.125rem;
    overflow: visible;
    filter: drop-shadow(0 6px 10px color-mix(in oklab, var(--accent) 30%, transparent));
  }
  .brand-tile {
    fill: var(--tile);
  }
  .brand-edge {
    fill: none;
    stroke: var(--tile-line);
  }
  .brand-grid {
    fill: var(--tile-text);
    opacity: 0.16;
  }
  .brand-route {
    fill: none;
    stroke: var(--tile-text);
    stroke-width: 3.4;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  .brand-milestone {
    fill: var(--tile);
  }
  .brand-start {
    fill: var(--tile);
    stroke: var(--tile-text);
    stroke-width: 1.8;
  }
  .brand-end {
    fill: color-mix(in oklab, var(--accent), white 40%);
  }
  .brand-start,
  .brand-end {
    transform-box: fill-box;
    transform-origin: center;
  }
  .brand:hover .brand-route,
  .brand:focus-visible .brand-route {
    animation: brand-route 720ms var(--ease-out-soft) both;
  }
  .brand:hover .brand-start,
  .brand:focus-visible .brand-start {
    animation: brand-pop 360ms var(--ease-out-soft) both;
  }
  .brand:hover .brand-end,
  .brand:focus-visible .brand-end {
    animation: brand-land 520ms var(--ease-out-soft) 560ms both;
  }
  @keyframes brand-route {
    from {
      stroke-dashoffset: 1;
    }
  }
  @keyframes brand-pop {
    40% {
      transform: scale(1.35);
    }
  }
  @keyframes brand-land {
    0% {
      transform: scale(0);
    }
    60% {
      transform: scale(1.3);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .brand:hover :is(.brand-route, .brand-start, .brand-end),
    .brand:focus-visible :is(.brand-route, .brand-start, .brand-end) {
      animation: none;
    }
  }

  /* Pill behind desktop nav links on hover and for the current section. */
  .nav-link::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 999px;
    background: var(--surface-2);
    opacity: 0;
    transform: scale(0.85);
    transition: opacity 200ms ease, transform 320ms var(--ease-out-soft);
  }
  .nav-link:hover::before,
  .nav-link[aria-current]::before {
    opacity: 1;
    transform: none;
  }

  /* Sun and moon rotate through each other when the theme changes. */
  .theme-icon {
    transition: transform 420ms var(--ease-out-soft), opacity 240ms ease;
  }
  :global([data-theme='dark']) .theme-icon-moon,
  :global([data-theme='light']) .theme-icon-sun {
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
  }

  /* Two bars that morph into an X. */
  .menu-bars {
    position: relative;
    width: 1.25rem;
    height: 0.75rem;
  }
  .menu-bars span {
    position: absolute;
    left: 0;
    right: 0;
    height: 1.5px;
    border-radius: 2px;
    background: var(--text);
    transition: transform 360ms var(--ease-out-soft), top 360ms var(--ease-out-soft);
  }
  .menu-bars span:first-child {
    top: 0;
  }
  .menu-bars span:last-child {
    top: calc(100% - 1.5px);
  }
  [aria-expanded='true'] .menu-bars span:first-child {
    top: calc(50% - 0.75px);
    transform: rotate(45deg);
  }
  [aria-expanded='true'] .menu-bars span:last-child {
    top: calc(50% - 0.75px);
    transform: rotate(-45deg);
  }

  /* Menu panel grows open; links follow in a short stagger. */
  .mobile-menu:not([hidden]) {
    display: grid;
  }
  .mobile-menu {
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows 420ms var(--ease-out-soft), opacity 260ms ease;
  }
  .mobile-menu > nav {
    overflow: hidden;
    min-height: 0;
  }
  .mobile-menu.is-open {
    grid-template-rows: 1fr;
    opacity: 1;
  }
  .mobile-menu li,
  .mobile-menu .btn {
    opacity: 0;
    transform: translateY(-10px);
    transition: opacity 260ms ease, transform 420ms var(--ease-out-soft);
  }
  .mobile-menu.is-open li,
  .mobile-menu.is-open .btn {
    opacity: 1;
    transform: none;
    transition-delay: calc(80ms + var(--i) * 45ms);
  }
</style>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  const label = () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    toggle?.setAttribute('aria-label', `Switch to ${next} theme`);
  };
  label();
  toggle?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Storage can be blocked; the theme still applies for this page view.
    }
    label();
  });

  // Mobile menu with open and close animation.
  const header = document.querySelector<HTMLElement>('[data-header]');
  const button = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const menuLabel = document.querySelector('[data-menu-label]');
  let closeTimer: number | undefined;

  const setOpen = (open: boolean) => {
    if (!button || !menu) return;
    window.clearTimeout(closeTimer);
    button.setAttribute('aria-expanded', String(open));
    if (menuLabel) menuLabel.textContent = open ? 'Close menu' : 'Open menu';
    if (open) {
      menu.hidden = false;
      // Force a style flush so the closed state is committed before the open transition starts.
      void menu.offsetHeight;
      menu.classList.add('is-open');
    } else {
      menu.classList.remove('is-open');
      closeTimer = window.setTimeout(() => (menu.hidden = true), 420);
    }
  };

  button?.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && button?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      button.focus();
    }
  });
  window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });

  // Hairline under the header once the page has scrolled.
  const sentinel = document.createElement('div');
  sentinel.setAttribute('aria-hidden', 'true');
  sentinel.style.cssText = 'position:absolute;top:0;left:0;height:8px;width:1px;pointer-events:none';
  document.body.prepend(sentinel);
  new IntersectionObserver(([entry]) => header?.classList.toggle('is-scrolled', !entry.isIntersecting)).observe(sentinel);
</script>
